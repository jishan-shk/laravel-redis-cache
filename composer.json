{
    "name": "jishan-shk/laravel-redis-cache",
    "description": "Laravel Redis cache store with pattern/tag based invalidation and model observer helpers.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "redis", "cache", "invalidation", "tags"],
    "authors": [
        {
            "name": "Jishan",
            "email": "shaikhjishan64@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/cache": "^10.0|^11.0|^12.0",
        "illuminate/redis": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "JishanShk\\RedisCache\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "JishanShk\\RedisCache\\RedisCacheServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
